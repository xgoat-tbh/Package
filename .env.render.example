# ==============================================================================
# Render Backend Environment Variables (syspy-installer / controller)
# Set these in your Render Dashboard: Web Service -> Environment -> Environment Variables
# ==============================================================================

# Python runtime version
PYTHON_VERSION=3.12.8

# Controller operating mode: "controller" to enable full API & dashboard, "webinstall" for one-liner only
SYSPY_MODE=controller

# Host & Proxy Configuration
# Render acts as a reverse proxy, so 1 hop is trusted.
SYSPY_HOST=0.0.0.0
SYSPY_TRUST_PROXY_HOPS=1

# Public URL of your Render web service (e.g., https://your-service.onrender.com)
SYSPY_URL=https://your-service.onrender.com

# Dashboard operator password (used to log into the web dashboard)
SYSPY_PASS=your-secure-password-here

# Communication Room (must be unique and match across controller and fleet)
SYSPY_ROOM=syspy-delta-7421

# MQTT Broker (optional if using default broker or customize: host:port:tls)
# SYSPY_BROKER=103.118.182.43:6969:false

# Allowed Host headers (optional, comma-separated list of accepted domain names)
# SYSPY_ALLOWED_HOSTS=your-service.onrender.com,your-frontend.vercel.app

# Cryptographic Keys (Optional: generate with 'python controller.py --genkey')
# SYSPY_SIGN_KEY=
# SYSPY_PUBKEY=
